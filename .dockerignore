# Match .gitignore mostly + a few container-specific excludes.
.git
.gitignore
.github

node_modules
.next
out
build
dist

# Local dev artifacts
.env
.env.local
.env*.local
*.log
.DS_Store

# Private reference materials (already gitignored; never put in image)
reference/
_private/

# Editor + OS
.vscode
.idea
Thumbs.db

# Build-time-only excludes — samples/ is imported by /sheet so it MUST ship.
# scripts/ WAS excluded here, which is why two deploys failed with a Dockerfile
# that copied it: the directory never existed in the build stage to copy FROM.
# It ships now so the episode worker can be run inside the container.
tests/
docs/

# Don't include any pre-built PDFs
*.pdf

# Don't ship the playwright local browser cache; image already has it
.cache

# keep the runtime image lean — demo pools ship, their PDFs don't
samples/generated/pdf
